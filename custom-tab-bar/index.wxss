.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 14rpx 0 calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e4efe7;
  box-shadow: 0 -8rpx 24rpx rgba(15, 143, 83, 0.05);
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #7b8794;
  font-size: 22rpx;
}

.tabbar__item--active {
  color: #0f8f53;
}

.tabbar__text {
  font-size: 22rpx;
}
