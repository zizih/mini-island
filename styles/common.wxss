.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #edf9f0 0%, #f8fcf9 200rpx, #f5fbf7 100%);
}

.hero-card,
.panel-card,
.filter-card,
.info-card,
.form-card,
.list-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 143, 83, 0.08);
  border: 1rpx solid rgba(15, 143, 83, 0.08);
}

.hero-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #113b24;
  line-height: 1.4;
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4d6b58;
}

.hero-tips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tip-pill {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #effaf3;
  color: #0f8f53;
  font-size: 24rpx;
}

.section-gap {
  margin-top: 24rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
}

.btn-item {
  flex: 1;
}

.mini-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.empty-wrap {
  padding: 48rpx 0;
}

.field-label {
  margin-bottom: 12rpx;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 600;
}

.field-group {
  margin-bottom: 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f5f3;
  color: #446153;
  font-size: 24rpx;
  border: 1rpx solid #d9e8de;
}

.chip--active {
  background: #e7f7ee;
  color: #0f8f53;
  border-color: #7dd3a3;
}

.agreement-box {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #f6faf7;
  border: 1rpx solid #deefe4;
  color: #466252;
  font-size: 24rpx;
  line-height: 1.7;
}

.warn-box {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f3fbf6;
  border: 1rpx solid #d7efdf;
}

.warn-title {
  color: #0f8f53;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.warn-text {
  color: #4d6b58;
  font-size: 24rpx;
  line-height: 1.8;
  white-space: pre-line;
}

.contact-inline,
.summary-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef4ef;
  font-size: 26rpx;
  color: #334155;
}

.contact-inline:last-child,
.summary-line:last-child {
  border-bottom: none;
}

.muted {
  color: #6b7280;
}

.highlight {
  color: #0f8f53;
  font-weight: 700;
}
