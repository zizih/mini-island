  <view class="section-gap"><post-card title="发布接机需求" subtitle="乘客发布机场接送、拼车、包车等需求" primaryText="去发布" bind:cardtap="goPickupPublish" bind:primarytap="goPickupPublish" /></view>
  <view class="section-gap"><post-card title="发布司机服务" subtitle="司机或车队发布可服务时间、车型、区域" primaryText="去发布" bind:cardtap="goDriverPublish" bind:primarytap="goDriverPublish" /></view>
</view>
