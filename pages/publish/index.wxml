<t-navbar title="发布信息" />

<view class="page-container">
  <view class="hero-card">
    <view class="hero-title">选择你要发布的内容</view>
    <view class="hero-desc">保持结构简单，先用本地 mock 数据模拟发布成功，方便你后续继续改造。</view>
  </view>

  <section-header title="发布入口" subtitle="按业务模块分别发布" />

