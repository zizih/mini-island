@import "../../styles/common.wxss";

.home-intro-card {
  margin-bottom: 20rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.home-intro-desc {
  margin-top: 0;
}

.search-panel {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
  padding: 8rpx 4rpx 0;
}

.search-input-wrap {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f5fcf7 0%, #edf8f1 100%);
  border: 1rpx solid #deefe4;
}

.quick-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.quick-tag {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f5f3;
  color: #446153;
  font-size: 24rpx;
  border: 1rpx solid #d9e8de;
}

.quick-tag--active {
  background: #e7f7ee;
  color: #0f8f53;
  border-color: #7dd3a3;
}

.feed-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(15, 143, 83, 0.08);
  box-shadow: 0 12rpx 36rpx rgba(15, 143, 83, 0.06);
}

.feed-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.feed-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #173524;
  line-height: 1.5;
}

.feed-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.feed-copy {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef8f1;
  flex-shrink: 0;
}

.feed-line {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #334155;
}

.feed-contact {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef4ef;
  font-size: 24rpx;
  color: #0f8f53;
  word-break: break-all;
}
