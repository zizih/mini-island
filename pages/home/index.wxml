<t-navbar title="海岛互联" />

<view class="page-container">
  <view class="search-panel">
    <section-header title="快速搜索" subtitle="只做信息发布、搜索、交流与匹配，不做支付、不做下单、不做履约。匹配后请通过微信或 WhatsApp 私下沟通，并自行核实信息。" />
    <view class="quick-tag-row">
      <view wx:for="{{quickTags}}" wx:key="*this" class="quick-tag {{activeTag === item ? 'quick-tag--active' : ''}}" data-tag="{{item}}" bindtap="toggleTag">{{item}}</view>
    </view>
    <view class="search-input-wrap">
      <t-input label="关键词" placeholder="例如：接机、司机、龙目岛、广州、行李互助" value="{{keyword}}" clearable bind:change="onKeywordChange" />
    </view>
  </view>

  <view wx:if="{{filteredFeedList.length}}">
    <view wx:for="{{filteredFeedList}}" wx:key="id" class="section-gap">
      <view class="feed-card">
        <view class="feed-head">
          <view>
            <view class="feed-title">{{item.title}}</view>
            <view class="feed-meta">{{item.module}} · {{item.category}}</view>
          </view>
          <view class="feed-copy" data-label="{{item.contactLabel}}" data-value="{{item.contactValue}}" bindtap="copyContact">
            <t-icon name="file-copy" size="34rpx" color="#0f8f53" />
          </view>
        </view>
        <view class="feed-line">{{item.line1}}</view>
        <view class="feed-line muted" wx:if="{{item.line2}}">{{item.line2}}</view>
        <view class="feed-line muted" wx:if="{{item.remark}}">{{item.remark}}</view>
        <view class="feed-contact">{{item.contactLabel}}：{{item.contactValue || '暂无'}}</view>
      </view>
    </view>
  </view>
  <view wx:else class="empty-wrap">
    <t-empty description="没有找到匹配的信息"></t-empty>
  </view>
</view>
